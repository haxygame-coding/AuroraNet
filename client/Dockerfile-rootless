# build & run locally with:
#   cd "$(git rev-parse --show-toplevel)"
#   CGO_ENABLED=0 go build -o auroranet ./client
#   podman build -t localhost/auroranet:latest -f client/Dockerfile --ignorefile .dockerignore-client .
#   podman run --rm -it --cap-add={BPF,NET_ADMIN,NET_RAW} localhost/auroranet:latest

FROM alpine:3.24

RUN apk add --no-cache \
      bash \
      ca-certificates \
    && adduser -D -h /var/lib/auroranet auroranet

WORKDIR /var/lib/auroranet
USER auroranet:auroranet

ENV \
    AURORANET_BIN="/usr/local/bin/auroranet" \
    NB_USE_NETSTACK_MODE="true" \
    NB_ENABLE_NETSTACK_LOCAL_FORWARDING="true" \
    NB_CONFIG="/var/lib/auroranet/config.json" \
    NB_STATE_DIR="/var/lib/auroranet" \
    NB_DAEMON_ADDR="unix:///var/lib/auroranet/auroranet.sock" \
    NB_LOG_FILE="console,/var/lib/auroranet/client.log" \
    NB_DISABLE_DNS="true" \
    NB_ENABLE_CAPTURE="false" \
    NB_ENTRYPOINT_SERVICE_TIMEOUT="30"

ENTRYPOINT [ "/usr/local/bin/auroranet-entrypoint.sh" ]
ARG TARGETPLATFORM
ARG AURORANET_BINARY=$TARGETPLATFORM/auroranet
COPY client/auroranet-entrypoint.sh /usr/local/bin/auroranet-entrypoint.sh
COPY "${AURORANET_BINARY}"  /usr/local/bin/auroranet
