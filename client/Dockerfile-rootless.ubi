FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed

ARG TARGETPLATFORM
ARG AURORANET_BINARY=$TARGETPLATFORM/auroranet
ARG VERSION=dev
ARG RELEASE=1

LABEL name="auroranet-rootless" \
      maintainer="AuroraNet <dev@aurora-net.org>" \
      vendor="AuroraNet" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="AuroraNet Rootless Client" \
      description="AuroraNet connects devices through an encrypted overlay using userspace networking without a TUN device or network administration capabilities."

RUN microdnf install -y bash ca-certificates && microdnf clean all

COPY --chmod=0555 client/auroranet-entrypoint.sh /usr/local/bin/auroranet-entrypoint.sh
COPY --chmod=0555 ${AURORANET_BINARY} /usr/local/bin/auroranet
COPY licenses/ /licenses/
# Only application storage is group-writable for arbitrary non-root UIDs.
# Runtime-created credentials keep the client's restrictive file modes.
RUN mkdir -p /var/lib/auroranet && \
    chown 1000:0 /var/lib/auroranet && \
    chmod 0770 /var/lib/auroranet && \
    chmod -R a+rX /licenses

WORKDIR /var/lib/auroranet
USER 1000:0

ENV \
    HOME="/var/lib/auroranet" \
    AURORANET_BIN="/usr/local/bin/auroranet" \
    NB_USE_NETSTACK_MODE="true" \
    NB_ENABLE_NETSTACK_LOCAL_FORWARDING="true" \
    NB_CONFIG="/var/lib/auroranet/config.json" \
    NB_STATE_DIR="/var/lib/auroranet" \
    NB_DAEMON_ADDR="unix:///var/lib/auroranet/auroranet.sock" \
    NB_LOG_FILE="console,/var/lib/auroranet/client.log" \
    NB_DISABLE_DNS="true" \
    NB_ENABLE_CAPTURE="false" \
    NB_ENTRYPOINT_SERVICE_TIMEOUT="30"

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/auroranet-entrypoint.sh"]
