{{ $projectName := env.Getenv "PROJECT" }}{{ $amdFilePath := env.Getenv "AMD" }}{{ $armFilePath := env.Getenv "ARM" }}
{{ $amdURL := env.Getenv "AMD_URL" }}{{ $armURL := env.Getenv "ARM_URL" }}
{{ $amdFile := filepath.Base $amdFilePath }}{{ $armFile := filepath.Base $armFilePath }}{{ $amdFileBytes := file.Read $amdFilePath }}
{{ $armFileBytes := file.Read $armFilePath }}# AuroraNet UI Client Cask Formula
cask "{{ $projectName }}" do
  version "{{ env.Getenv "VERSION" }}"

  if Hardware::CPU.intel?
      url "{{ $amdURL }}"
      sha256 "{{ crypto.SHA256 $amdFileBytes }}"
      app "auroranet_ui_darwin", target: "AuroraNet.app"
  else
      url "{{ $armURL }}"
      sha256 "{{ crypto.SHA256 $armFileBytes }}"
      app "auroranet_ui_darwin", target: "AuroraNet.app"
  end

  depends_on formula: "auroranet"

  postflight_steps do
    set_permissions ["AuroraNet.app/installer.sh", "AuroraNet.app/uninstaller.sh"], "0755",
                    base: :appdir, recursive: false
    run "AuroraNet.app/installer.sh", args: ["#{version}"], base: :appdir, sudo: true
  end

  uninstall_preflight_steps do
    run "/bin/launchctl", args: ["bootout", "system/auroranet"], sudo: true, must_succeed: false
    run "/bin/launchctl", args: ["unload", "/Library/LaunchDaemons/auroranet.plist"],
        sudo: true, must_succeed: false
    remove "/Library/LaunchDaemons/auroranet.plist", sudo: true
  end

  name "AuroraNet UI"
  desc "AuroraNet UI Client"
  homepage "https://aurora-net.org/"
end
