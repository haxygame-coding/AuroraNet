<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="auroranet-ui"
        Arguments=""
        InstallLocation="C:\Program Files\AuroraNet\AuroraNet">
    </Installer>
    <PackageInformation
        PackageName="AuroraNet"
        PackageDisplayName="AuroraNet"
        PublisherName="CN=AuroraNet"
        PublisherDisplayName="AuroraNet"
        Version="0.0.1.0"
        PackageDescription="AuroraNet desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.auroranet.client"
                Description="AuroraNet desktop client"
                DisplayName="AuroraNet"
                ExecutableName="auroranet-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>AuroraNet</DisplayName>
            <PublisherDisplayName>AuroraNet</PublisherDisplayName>
            <Description>AuroraNet desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="auroranet-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
