FROM golang:1.26.10-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY client ./client
COPY dns ./dns
COPY encryption ./encryption
COPY flow ./flow
COPY formatter ./formatter
COPY monotime ./monotime
COPY management ./management
COPY proxy ./proxy
COPY route ./route
COPY shared ./shared
COPY sharedsock ./sharedsock
COPY trustedproxy ./trustedproxy
COPY upload-server ./upload-server
COPY util ./util
COPY version ./version
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o auroranet-proxy ./proxy/cmd/proxy

RUN echo "auroranet:x:1000:1000:auroranet:/var/lib/auroranet:/sbin/nologin" > /tmp/passwd && \
    echo "auroranet:x:1000:auroranet" > /tmp/group && \
    mkdir -p /tmp/var/lib/auroranet && \
    mkdir -p /tmp/certs

FROM gcr.io/distroless/base:debug
COPY --from=builder /app/auroranet-proxy /usr/bin/auroranet-proxy
COPY --from=builder /tmp/passwd /etc/passwd
COPY --from=builder /tmp/group /etc/group
COPY --from=builder --chown=1000:1000 /tmp/var/lib/auroranet /var/lib/auroranet
COPY --from=builder --chown=1000:1000 --chmod=755 /tmp/certs /certs
USER auroranet:auroranet
ENV HOME=/var/lib/auroranet
ENV NB_PROXY_ADDRESS=":8443"
EXPOSE 8443
ENTRYPOINT ["/usr/bin/auroranet-proxy"]
