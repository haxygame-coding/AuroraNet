## Most settings are being done automatically with the sourced variables from setup.env, but you can edit if you need some customization

# Management API

# Management API port
AURORANET_MGMT_API_PORT=${AURORANET_MGMT_API_PORT:-33073}
# Management API endpoint address, used by the Dashboard
AURORANET_MGMT_API_ENDPOINT=https://$AURORANET_DOMAIN:$AURORANET_MGMT_API_PORT
# Management Certificate file path. These are generated by the Dashboard container
AURORANET_LETSENCRYPT_DOMAIN=$AURORANET_DOMAIN
AURORANET_MGMT_API_CERT_FILE="/etc/letsencrypt/live/$AURORANET_LETSENCRYPT_DOMAIN/fullchain.pem"
# Management Certificate key file path.
AURORANET_MGMT_API_CERT_KEY_FILE="/etc/letsencrypt/live/$AURORANET_LETSENCRYPT_DOMAIN/privkey.pem"
# By default Management single account mode is enabled and domain set to $AURORANET_DOMAIN, you may want to set this to your user's email domain
AURORANET_MGMT_SINGLE_ACCOUNT_MODE_DOMAIN=$AURORANET_DOMAIN
AURORANET_MGMT_DNS_DOMAIN=${AURORANET_MGMT_DNS_DOMAIN:-auroranet.selfhosted}
AURORANET_MGMT_IDP_SIGNKEY_REFRESH=${AURORANET_MGMT_IDP_SIGNKEY_REFRESH:-false}
AURORANET_MGMT_DISABLE_DEFAULT_POLICY=${AURORANET_MGMT_DISABLE_DEFAULT_POLICY:-false}

# Signal
AURORANET_SIGNAL_PROTOCOL="http"
AURORANET_SIGNAL_PORT=${AURORANET_SIGNAL_PORT:-10000}

# Relay
AURORANET_RELAY_DOMAIN=${AURORANET_RELAY_DOMAIN:-$AURORANET_DOMAIN}
AURORANET_RELAY_PORT=${AURORANET_RELAY_PORT:-33080}
AURORANET_RELAY_ENDPOINT=${AURORANET_RELAY_ENDPOINT:-rel://$AURORANET_RELAY_DOMAIN:$AURORANET_RELAY_PORT}
# Relay auth secret
AURORANET_RELAY_AUTH_SECRET=

# Turn
TURN_DOMAIN=${AURORANET_TURN_DOMAIN:-$AURORANET_DOMAIN}

AURORANET_TURN_EXTERNAL_IP=${AURORANET_TURN_EXTERNAL_IP}

# Turn credentials
# User
TURN_USER=self
# Password. If empty, the configure.sh will generate one with openssl
TURN_PASSWORD=
# Min port
TURN_MIN_PORT=${TURN_MIN_PORT:-49152}
# Max port
TURN_MAX_PORT=${TURN_MAX_PORT:-65535}

VOLUME_PREFIX="auroranet-"
MGMT_VOLUMESUFFIX="mgmt"
SIGNAL_VOLUMESUFFIX="signal"
LETSENCRYPT_VOLUMESUFFIX="letsencrypt"

AURORANET_AUTH_DEVICE_AUTH_PROVIDER="none"
AURORANET_AUTH_DEVICE_AUTH_AUDIENCE=${AURORANET_AUTH_DEVICE_AUTH_AUDIENCE:-$AURORANET_AUTH_AUDIENCE}
AURORANET_AUTH_DEVICE_AUTH_SCOPE=${AURORANET_AUTH_DEVICE_AUTH_SCOPE:-openid}
AURORANET_AUTH_DEVICE_AUTH_USE_ID_TOKEN=${AURORANET_AUTH_DEVICE_AUTH_USE_ID_TOKEN:-false}


AURORANET_DISABLE_ANONYMOUS_METRICS=${AURORANET_DISABLE_ANONYMOUS_METRICS:-false}
AURORANET_TOKEN_SOURCE=${AURORANET_TOKEN_SOURCE:-accessToken}

# PKCE authorization flow
AURORANET_AUTH_PKCE_REDIRECT_URL_PORTS=${AURORANET_AUTH_PKCE_REDIRECT_URL_PORTS:-"53000"}
AURORANET_AUTH_PKCE_USE_ID_TOKEN=${AURORANET_AUTH_PKCE_USE_ID_TOKEN:-false}
AURORANET_AUTH_PKCE_DISABLE_PROMPT_LOGIN=${AURORANET_AUTH_PKCE_DISABLE_PROMPT_LOGIN:-false}
AURORANET_AUTH_PKCE_LOGIN_FLAG=${AURORANET_AUTH_PKCE_LOGIN_FLAG:-0}
AURORANET_AUTH_PKCE_AUDIENCE=$AURORANET_AUTH_AUDIENCE

# Dashboard

# The default setting is to transmit the audience to the IDP during authorization. However,
# if your IDP does not have this capability, you can turn this off by setting it to false.
AURORANET_DASH_AUTH_USE_AUDIENCE=${AURORANET_DASH_AUTH_USE_AUDIENCE:-true}
AURORANET_DASH_AUTH_AUDIENCE=$AURORANET_AUTH_AUDIENCE

# Store config
AURORANET_STORE_CONFIG_ENGINE=${AURORANET_STORE_CONFIG_ENGINE:-"sqlite"}

# Image tags
AURORANET_DASHBOARD_TAG=${AURORANET_DASHBOARD_TAG:-"latest"}
AURORANET_SIGNAL_TAG=${AURORANET_SIGNAL_TAG:-"latest"}
AURORANET_MANAGEMENT_TAG=${AURORANET_MANAGEMENT_TAG:-"latest"}
COTURN_TAG=${COTURN_TAG:-"latest"}
AURORANET_RELAY_TAG=${AURORANET_RELAY_TAG:-"latest"}

# exports
export AURORANET_DOMAIN
export AURORANET_TURN_DOMAIN
export AURORANET_AUTH_CLIENT_ID
export AURORANET_AUTH_CLIENT_SECRET
export AURORANET_AUTH_AUDIENCE
export AURORANET_AUTH_AUTHORITY
export AURORANET_USE_AUTH0
export AURORANET_AUTH_SUPPORTED_SCOPES
export AURORANET_AUTH_JWT_CERTS
export AURORANET_LETSENCRYPT_EMAIL
export AURORANET_MGMT_API_PORT
export AURORANET_MGMT_API_ENDPOINT
export AURORANET_LETSENCRYPT_DOMAIN
export AURORANET_MGMT_API_CERT_FILE
export AURORANET_MGMT_API_CERT_KEY_FILE
export AURORANET_AUTH_DEVICE_AUTH_PROVIDER
export AURORANET_AUTH_DEVICE_AUTH_CLIENT_ID
export AURORANET_AUTH_OIDC_CONFIGURATION_ENDPOINT
export AURORANET_AUTH_REDIRECT_URI
export AURORANET_AUTH_SILENT_REDIRECT_URI
export TURN_DOMAIN
export TURN_USER
export TURN_PASSWORD
export TURN_MIN_PORT
export TURN_MAX_PORT
export VOLUME_PREFIX
export MGMT_VOLUMESUFFIX
export SIGNAL_VOLUMESUFFIX
export LETSENCRYPT_VOLUMESUFFIX
export AURORANET_DISABLE_ANONYMOUS_METRICS
export AURORANET_MGMT_SINGLE_ACCOUNT_MODE_DOMAIN
export AURORANET_MGMT_DNS_DOMAIN
export AURORANET_MGMT_IDP_SIGNKEY_REFRESH
export AURORANET_SIGNAL_PROTOCOL
export AURORANET_SIGNAL_PORT
export AURORANET_AUTH_USER_ID_CLAIM
export AURORANET_AUTH_DEVICE_AUTH_AUDIENCE
export AURORANET_TOKEN_SOURCE
export AURORANET_AUTH_DEVICE_AUTH_SCOPE
export AURORANET_AUTH_DEVICE_AUTH_USE_ID_TOKEN
export AURORANET_AUTH_PKCE_AUTHORIZATION_ENDPOINT
export AURORANET_AUTH_PKCE_USE_ID_TOKEN
export AURORANET_AUTH_PKCE_DISABLE_PROMPT_LOGIN
export AURORANET_AUTH_PKCE_LOGIN_FLAG
export AURORANET_AUTH_PKCE_AUDIENCE
export AURORANET_DASH_AUTH_USE_AUDIENCE
export AURORANET_DASH_AUTH_AUDIENCE
export AURORANET_STORE_CONFIG_ENGINE
export AURORANET_DASHBOARD_TAG
export AURORANET_SIGNAL_TAG
export AURORANET_MANAGEMENT_TAG
export COTURN_TAG
export AURORANET_TURN_EXTERNAL_IP
export AURORANET_RELAY_DOMAIN
export AURORANET_RELAY_PORT
export AURORANET_RELAY_ENDPOINT
export AURORANET_RELAY_AUTH_SECRET
export AURORANET_RELAY_TAG
export AURORANET_MGMT_DISABLE_DEFAULT_POLICY
