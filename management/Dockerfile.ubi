FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:2d4c4551af6831dcd26bbf86108c4385de5183ec8fe6b5868f6f9640fe47f4ed

ARG TARGETPLATFORM
ARG VERSION=dev
ARG RELEASE=1

LABEL name="auroranet-management" \
      maintainer="AuroraNet <dev@aurora-net.org>" \
      vendor="AuroraNet" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="AuroraNet Management" \
      description="AuroraNet Management is the control plane of an AuroraNet network and serves its REST and gRPC APIs."

COPY --chmod=0555 ${TARGETPLATFORM}/auroranet-mgmt /go/bin/auroranet-mgmt
COPY licenses/ /licenses/
# Only the data directory shares the root group for arbitrary non-root UIDs.
# Runtime-created keys and databases retain the application's restrictive modes.
RUN mkdir -p /var/lib/auroranet /etc/auroranet && \
    chown 1000:0 /var/lib/auroranet && \
    chmod 0770 /var/lib/auroranet && \
    chmod -R a+rX /licenses

USER 1000:0
ENV HOME=/var/lib/auroranet
# Runtimes such as OpenShift and Podman reserve ports below 1024 for root, so
# --port defaults to 8080 here. With --letsencrypt-domain, forward public 443
# to --port and set --letsencrypt-listen-address to empty, so the main listener
# answers the TLS-ALPN challenges. 33073 is the legacy gRPC port.
EXPOSE 8080 33073
STOPSIGNAL SIGTERM
ENTRYPOINT ["/go/bin/auroranet-mgmt", "management"]
CMD ["--port", "8080", "--log-file", "console"]
