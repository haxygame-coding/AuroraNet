[Unit]
Description=AuroraNet Signal
Documentation=https://aurora-net.org/docs
After=network-online.target syslog.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/auroranet-signal
ExecStart=/usr/bin/auroranet-signal run $FLAGS
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
CacheDirectory=auroranet
ConfigurationDirectory=auroranet
LogsDirectory=auroranet
RuntimeDirectory=auroranet
StateDirectory=auroranet

# sandboxing
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=yes
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target

